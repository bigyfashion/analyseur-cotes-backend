# Copie ce fichier en .env et remplis les valeurs reelles. Ne jamais commiter .env.

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Secret de signature des jetons de session. Genere une valeur aleatoire longue, ex:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Jeton de configuration initiale: permet de creer le tout premier compte administrateur
# via POST /api/v1/setup/create-admin (en-tete x-setup-token) sans avoir besoin d'un
# acces Shell (indisponible sur le palier gratuit de plusieurs hebergeurs, dont Render).
# Genere une valeur aleatoire longue de la meme facon que JWT_SECRET, garde-la secrete.
SETUP_TOKEN=

# Base de donnees (SQLite locale par defaut; passer a une base managee en production)
DB_PATH=./db/app.db

# --- Passerelles de paiement: laisser vide tant que les contrats marchands ne sont pas obtenus ---
# Tant que ces variables sont vides, les modules correspondants restent non-configures
# et l'administration NE PEUT PAS les activer (verifie cote serveur, pas seulement
# cote interface).

# Orange Money (contrat marchand + cles API par pays)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

# MTN Mobile Money (API MoMo, contrat marchand par pays)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=

# Carte bancaire (processeur a determiner - voir README, Stripe/PayPal restreignent
# la categorie "pronostics sportifs")
CARD_PROCESSOR_SECRET_KEY=
CARD_PROCESSOR_WEBHOOK_SECRET=

# PayPal (compte Business requis)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
